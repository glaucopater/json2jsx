{
  "name": "json2jsx",
  "version": "1.3.0",
  "description": "A node js library that transforms a json file into a set of react components",
  "main": "index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "generate": "node cli.js",
    "demo": "node cli.js json_samples/test.json test_run",
    "playground:setup": "node scripts/init-playground.js",
    "playground:install": "node scripts/init-playground.js --install",
    "playground": "node scripts/init-playground.js && yarn --cwd output/playground dev",
    "start": "yarn demo && yarn playground"
  },
  "files": [
    "index.js",
    "cli.js",
    "config.json",
    "src/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glaucopater/json2jsx.git"
  },
  "keywords": [
    "json",
    "react",
    "test"
  ],
  "author": "Glauco Pater",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/glaucopater/json2jsx/issues"
  },
  "homepage": "http://flagg.altervista.org/blog/json2jsx/",
  "bin": "cli.js",
  "devDependencies": {
    "jest": "^30.0.0"
  },
  "dependencies": {
    "prettier": "^3.6.0"
  }
}

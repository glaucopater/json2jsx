{
  "name": "json2jsx",
  "version": "1.3.2",
  "description": "A node js library that transforms a json file into a set of react components",
  "main": "index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "vitest run",
    "generate": "node cli.js",
    "demo": "node cli.js json_samples/test.json test_run",
    "demo:gallery": "node cli.js json_samples/media-gallery.json gallery",
    "demo:pokemon": "node cli.js json_samples/pokemon.json pokemon",
    "playground:setup": "node scripts/init-playground.js",
    "playground:install": "node scripts/init-playground.js --install",
    "playground": "node scripts/init-playground.js && node scripts/run-playground.js",
    "preview": "node scripts/generate-and-playground.js",
    "preview:gallery": "node scripts/generate-and-playground.js json_samples/media-gallery.json gallery",
    "preview:pokemon": "node scripts/generate-and-playground.js json_samples/pokemon.json pokemon",
    "start": "node scripts/generate-and-playground.js"
  },
  "files": [
    "index.js",
    "cli.js",
    "config.json",
    "src/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glaucopater/json2jsx.git"
  },
  "keywords": [
    "json",
    "react",
    "test"
  ],
  "author": "Glauco Pater",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/glaucopater/json2jsx/issues"
  },
  "homepage": "http://flagg.altervista.org/blog/json2jsx/",
  "bin": "cli.js",
  "packageManager": "yarn@4.13.0",
  "dependencies": {
    "prettier": "^3.6.0"
  },
  "devDependencies": {
    "vitest": "4.1.0"
  }
}
